{
  "repo": "baybailz/data-engineering-scenario-crm-dedupe",
  "title": "Company Data Pipeline",
  "subtitle": "Data engineering scenario · Bailey Thompson",
  "author": "Bailey Thompson",
  "workflow": "pipeline.yml",
  "actions": {
    "run": "load_next",
    "reset": "reset"
  },
  "run_label": "Run data pipeline",
  "dbt_select": "tag:scenario",
  "pipeline_steps": [
    {
      "key": "python",
      "label": "Python"
    },
    {
      "key": "dbt",
      "label": "dbt build"
    },
    {
      "key": "out",
      "label": "Conformed tables"
    }
  ],
  "arch_subtitles": {
    "python": "run.py",
    "dbt": "--select tag:scenario",
    "out": "export_json.py"
  },
  "landing": {
    "seed": "purchased_company",
    "columns": [
      "company_name",
      "address_1",
      "address_2",
      "address_3",
      "city",
      "state",
      "zip",
      "website",
      "primary_phone_number"
    ]
  },
  "export": {
    "tables": [
      "dim_company",
      "dim_record_status",
      "dim_company_duplicates",
      "dm_naive_import"
    ],
    "layers": [
      "seed",
      "stage",
      "transform",
      "conformed",
      "datamart"
    ]
  }
}
